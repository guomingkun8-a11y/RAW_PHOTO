# Runtime identity
GMKRAW_ENVIRONMENT=production
GMKRAW_AUTH_KEY=replace-with-a-long-random-value
GMKRAW_BASE_URL=https://images.example.com
GMKRAW_STRICT_SECRET_SOURCES=true

# MySQL
MYSQL_DATABASE=raw_photo
MYSQL_USER=raw_photo
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
MYSQL_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
GMKRAW_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
IMAGE_TASK_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
IMAGE_TASK_DB_POOL_SIZE=10
IMAGE_TASK_DB_MAX_OVERFLOW=20

# Redis queue
REDIS_PASSWORD=replace-with-a-strong-password
IMAGE_TASK_QUEUE_ENABLED=true
IMAGE_TASK_EXECUTOR=celery
IMAGE_TASK_REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0
IMAGE_TASK_QUEUE_NAME=ai_image_tasks
IMAGE_TASK_MAX_RETRIES=2
# 0 = auto from account pool; set a fixed value to cap global concurrency
IMAGE_TASK_TOTAL_CONCURRENCY=5
IMAGE_TASK_WORKER_CONCURRENCY=5
IMAGE_TASK_OWNER_CONCURRENCY=2
IMAGE_TASK_OWNER_PENDING_LIMIT=30
IMAGE_TASK_SLOT_LEASE_SECS=7200

# OpenAI-compatible relay
GMKRAW_OPENAI_RELAY_ENABLED=true
GMKRAW_OPENAI_RELAY_BASE_URL=https://relay.example.com/v1
GMKRAW_OPENAI_RELAY_API_KEY=replace-with-relay-api-key
GMKRAW_PROMPT_ANALYSIS_MODEL=gpt-4o

# Qiniu reference uploads
GMKRAW_QINIU_ACCESS_KEY=replace-with-qiniu-access-key
GMKRAW_QINIU_SECRET_KEY=replace-with-qiniu-secret-key
GMKRAW_QINIU_BUCKET=replace-with-bucket
GMKRAW_QINIU_DOMAIN=https://cdn.example.com
GMKRAW_QINIU_UPLOAD_URL=https://upload-z0.qiniup.com
GMKRAW_QINIU_PREFIX=gmkraw/reference
GMKRAW_QINIU_TASK_PREFIX=gmkraw/task-assets

# Optional AI review
GMKRAW_AI_REVIEW_ENABLED=false
GMKRAW_AI_REVIEW_BASE_URL=
GMKRAW_AI_REVIEW_API_KEY=
GMKRAW_AI_REVIEW_MODEL=
GMKRAW_AI_REVIEW_FAIL_OPEN=true

# Optional proxy and Cloudflare clearance
GMKRAW_PROXY_RUNTIME_ENABLED=false
GMKRAW_PROXY_EGRESS_MODE=direct
GMKRAW_PROXY_URL=
GMKRAW_RESOURCE_PROXY_URL=
GMKRAW_CF_COOKIES=
GMKRAW_CF_CLEARANCE=
GMKRAW_FLARESOLVERR_URL=

# Optional WebDAV or MinIO image storage
GMKRAW_IMAGE_STORAGE_ENABLED=false
GMKRAW_IMAGE_STORAGE_MODE=local
GMKRAW_IMAGE_STORAGE_PROVIDER=qiniu
GMKRAW_WEBDAV_URL=
GMKRAW_WEBDAV_USERNAME=
GMKRAW_WEBDAV_PASSWORD=
GMKRAW_WEBDAV_ROOT_PATH=gmkraw/images
GMKRAW_MINIO_ENDPOINT=
GMKRAW_MINIO_ACCESS_KEY=
GMKRAW_MINIO_SECRET_KEY=
GMKRAW_MINIO_BUCKET=
GMKRAW_MINIO_ROOT_PATH=raw-photo/images
GMKRAW_QINIU_REGION=z0
GMKRAW_QINIU_PRIVATE=false

# Optional Cloudflare R2 backups
GMKRAW_BACKUP_ENABLED=false
GMKRAW_BACKUP_ACCOUNT_ID=
GMKRAW_BACKUP_ACCESS_KEY_ID=
GMKRAW_BACKUP_SECRET_ACCESS_KEY=
GMKRAW_BACKUP_BUCKET=
GMKRAW_BACKUP_PREFIX=backups
GMKRAW_BACKUP_PASSPHRASE=
