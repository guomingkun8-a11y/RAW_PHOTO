# Runtime identity
CHATGPT2API_ENVIRONMENT=production
CHATGPT2API_AUTH_KEY=replace-with-a-long-random-value
CHATGPT2API_BASE_URL=https://images.example.com
CHATGPT2API_STRICT_SECRET_SOURCES=true

# MySQL
MYSQL_DATABASE=raw_photo
MYSQL_USER=raw_photo
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
MYSQL_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
CHATGPT2API_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
IMAGE_TASK_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
IMAGE_TASK_DB_POOL_SIZE=10
IMAGE_TASK_DB_MAX_OVERFLOW=20

# Redis queue
REDIS_PASSWORD=replace-with-a-strong-password
IMAGE_TASK_QUEUE_ENABLED=true
IMAGE_TASK_EXECUTOR=celery
IMAGE_TASK_REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0
IMAGE_TASK_QUEUE_NAME=ai_image_tasks
IMAGE_TASK_MAX_RETRIES=2
# 0 = auto from account pool; set a fixed value to cap global concurrency
IMAGE_TASK_TOTAL_CONCURRENCY=5
IMAGE_TASK_WORKER_CONCURRENCY=5
IMAGE_TASK_OWNER_CONCURRENCY=2
IMAGE_TASK_OWNER_PENDING_LIMIT=30
IMAGE_TASK_SLOT_LEASE_SECS=7200

# OpenAI-compatible relay
CHATGPT2API_OPENAI_RELAY_ENABLED=true
CHATGPT2API_OPENAI_RELAY_BASE_URL=https://relay.example.com/v1
CHATGPT2API_OPENAI_RELAY_API_KEY=replace-with-relay-api-key
CHATGPT2API_PROMPT_ANALYSIS_MODEL=gpt-4o

# Qiniu reference uploads
CHATGPT2API_QINIU_ACCESS_KEY=replace-with-qiniu-access-key
CHATGPT2API_QINIU_SECRET_KEY=replace-with-qiniu-secret-key
CHATGPT2API_QINIU_BUCKET=replace-with-bucket
CHATGPT2API_QINIU_DOMAIN=https://cdn.example.com
CHATGPT2API_QINIU_UPLOAD_URL=https://upload-z0.qiniup.com
CHATGPT2API_QINIU_PREFIX=chatgpt2api/reference
CHATGPT2API_QINIU_TASK_PREFIX=chatgpt2api/task-assets

# Optional AI review
CHATGPT2API_AI_REVIEW_ENABLED=false
CHATGPT2API_AI_REVIEW_BASE_URL=
CHATGPT2API_AI_REVIEW_API_KEY=
CHATGPT2API_AI_REVIEW_MODEL=
CHATGPT2API_AI_REVIEW_FAIL_OPEN=true

# Optional proxy and Cloudflare clearance
CHATGPT2API_PROXY_RUNTIME_ENABLED=false
CHATGPT2API_PROXY_EGRESS_MODE=direct
CHATGPT2API_PROXY_URL=
CHATGPT2API_RESOURCE_PROXY_URL=
CHATGPT2API_CF_COOKIES=
CHATGPT2API_CF_CLEARANCE=
CHATGPT2API_FLARESOLVERR_URL=

# Optional WebDAV or MinIO image storage
CHATGPT2API_IMAGE_STORAGE_ENABLED=false
CHATGPT2API_IMAGE_STORAGE_MODE=local
CHATGPT2API_IMAGE_STORAGE_PROVIDER=qiniu
CHATGPT2API_WEBDAV_URL=
CHATGPT2API_WEBDAV_USERNAME=
CHATGPT2API_WEBDAV_PASSWORD=
CHATGPT2API_WEBDAV_ROOT_PATH=chatgpt2api/images
CHATGPT2API_MINIO_ENDPOINT=
CHATGPT2API_MINIO_ACCESS_KEY=
CHATGPT2API_MINIO_SECRET_KEY=
CHATGPT2API_MINIO_BUCKET=
CHATGPT2API_MINIO_ROOT_PATH=raw-photo/images
CHATGPT2API_QINIU_REGION=z0
CHATGPT2API_QINIU_PRIVATE=false

# Optional Cloudflare R2 backups
CHATGPT2API_BACKUP_ENABLED=false
CHATGPT2API_BACKUP_ACCOUNT_ID=
CHATGPT2API_BACKUP_ACCESS_KEY_ID=
CHATGPT2API_BACKUP_SECRET_ACCESS_KEY=
CHATGPT2API_BACKUP_BUCKET=
CHATGPT2API_BACKUP_PREFIX=backups
CHATGPT2API_BACKUP_PASSPHRASE=
