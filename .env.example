# Runtime identity
GMKRAW_ENVIRONMENT=production
GMKRAW_ENTERPRISE_MODE=true
GMKRAW_REQUIRE_VECTOR_SEARCH=true
GMKRAW_AUTH_KEY=replace-with-a-long-random-value
GMKRAW_LEGACY_AUTH_KEY_ADMIN_ENABLED=false
GMKRAW_BASE_URL=https://images.example.com
GMKRAW_STRICT_SECRET_SOURCES=true

# MySQL
MYSQL_DATABASE=raw_photo
MYSQL_USER=raw_photo
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
MYSQL_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
GMKRAW_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
IMAGE_TASK_DATABASE_URL=mysql+pymysql://raw_photo:replace-with-a-strong-password@mysql:3306/raw_photo?charset=utf8mb4
IMAGE_TASK_DB_POOL_SIZE=10
IMAGE_TASK_DB_MAX_OVERFLOW=20

# Redis queue
REDIS_PASSWORD=replace-with-a-strong-password
IMAGE_TASK_QUEUE_ENABLED=true
IMAGE_TASK_EXECUTOR=celery
IMAGE_TASK_REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0
IMAGE_TASK_QUEUE_NAME=ai_image_tasks
IMAGE_TASK_MAX_RETRIES=2
# 0 = auto from account pool; set a fixed value to cap global concurrency
IMAGE_TASK_TOTAL_CONCURRENCY=5
IMAGE_TASK_WORKER_CONCURRENCY=5
IMAGE_TASK_OWNER_CONCURRENCY=2
IMAGE_TASK_DYNAMIC_OWNER_CONCURRENCY_ENABLED=false
IMAGE_TASK_DYNAMIC_OWNER_CONCURRENCY_THRESHOLD=10
IMAGE_TASK_DYNAMIC_OWNER_CONCURRENCY_MAX=20
IMAGE_TASK_OWNER_PENDING_LIMIT=30
IMAGE_TASK_SLOT_LEASE_SECS=7200
IMAGE_TASK_ADAPTIVE_CONCURRENCY_ENABLED=true
IMAGE_TASK_ADAPTIVE_MIN_CONCURRENCY=5
IMAGE_TASK_ADAPTIVE_RECOVERY_SUCCESSES=12
IMAGE_TASK_ADAPTIVE_COOLDOWN_SECS=30
IMAGE_TASK_POSTPROCESS_CONCURRENCY=8

# Professional Agent persistent queue
AGENT_QUEUE_ENABLED=true
AGENT_REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0
AGENT_QUEUE_NAME=professional_agent_jobs
AGENT_WORKER_CONCURRENCY=4
AGENT_TOTAL_CONCURRENCY=4
AGENT_OWNER_CONCURRENCY=1
AGENT_OWNER_PENDING_LIMIT=10
AGENT_SLOT_LEASE_SECS=900
AGENT_JOB_RETENTION_SECS=86400
AGENT_MAX_RETRIES=3
AGENT_RETRY_BASE_DELAY_SECS=2
AGENT_RETRY_MAX_DELAY_SECS=60
AGENT_DEAD_LETTER_RETENTION_SECS=604800
AGENT_MEMORY_DISTILLATION_ENABLED=true
AGENT_MEMORY_DISTILLATION_MODEL=
AGENT_MEMORY_AUTO_MIN_CONFIDENCE=0.72
AGENT_MEMORY_DISTILLATION_MIN_USER_CHARS=24
AGENT_MEMORY_DREAM_ENABLED=true
# Optional professional Agent web search provider.
SERPAPI_API_KEY=
# Optional shared vector index for multi-instance deployments.
QDRANT_URL=
QDRANT_API_KEY=replace-with-a-strong-qdrant-api-key
QDRANT_COLLECTION=raw_professional_memory
QDRANT_FOLDER_COLLECTION=raw_professional_folder_assets
QDRANT_KNOWLEDGE_COLLECTION=raw_professional_knowledge

# OpenAI-compatible relay
GMKRAW_OPENAI_RELAY_ENABLED=true
GMKRAW_OPENAI_RELAY_BASE_URL=https://relay.example.com/v1
GMKRAW_OPENAI_RELAY_API_KEY=replace-with-relay-api-key
GMKRAW_EMBEDDING_BASE_URL=https://embedding.example.com/v1
GMKRAW_EMBEDDING_API_KEY=replace-with-embedding-api-key
GMKRAW_EMBEDDING_MODEL=text-embedding-3-small
GMKRAW_PROMPT_ANALYSIS_MODEL=gpt-4o

# Aliyun OSS reference uploads
GMKRAW_IMAGE_REFERENCE_UPLOAD_ENABLED=true
GMKRAW_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
GMKRAW_OSS_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
GMKRAW_OSS_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
GMKRAW_OSS_BUCKET=replace-with-bucket
GMKRAW_OSS_REGION=oss-cn-beijing
GMKRAW_OSS_REFERENCE_PREFIX=raw-photo/reference
GMKRAW_OSS_REFERENCE_PUBLIC_BASE_URL=https://replace-with-bucket.oss-cn-beijing.aliyuncs.com

# Optional AI review
GMKRAW_AI_REVIEW_ENABLED=false
GMKRAW_AI_REVIEW_BASE_URL=
GMKRAW_AI_REVIEW_API_KEY=
GMKRAW_AI_REVIEW_MODEL=
GMKRAW_AI_REVIEW_FAIL_OPEN=true

# Optional proxy and Cloudflare clearance
GMKRAW_PROXY_RUNTIME_ENABLED=false
GMKRAW_PROXY_EGRESS_MODE=direct
GMKRAW_PROXY_URL=
GMKRAW_RESOURCE_PROXY_URL=
GMKRAW_CF_COOKIES=
GMKRAW_CF_CLEARANCE=
GMKRAW_FLARESOLVERR_URL=

# Optional WebDAV or Aliyun OSS image storage
GMKRAW_IMAGE_STORAGE_ENABLED=false
GMKRAW_IMAGE_STORAGE_MODE=local
GMKRAW_IMAGE_STORAGE_PROVIDER=minio
GMKRAW_WEBDAV_URL=
GMKRAW_WEBDAV_USERNAME=
GMKRAW_WEBDAV_PASSWORD=
GMKRAW_WEBDAV_ROOT_PATH=gmkraw/images
GMKRAW_MINIO_ENDPOINT=
GMKRAW_MINIO_ACCESS_KEY=
GMKRAW_MINIO_SECRET_KEY=
GMKRAW_MINIO_BUCKET=
GMKRAW_MINIO_ROOT_PATH=raw-photo/images
GMKRAW_IMAGE_STORAGE_PUBLIC_BASE_URL=

# Optional Cloudflare R2 backups
GMKRAW_BACKUP_ENABLED=false
GMKRAW_BACKUP_ACCOUNT_ID=
GMKRAW_BACKUP_ACCESS_KEY_ID=
GMKRAW_BACKUP_SECRET_ACCESS_KEY=
GMKRAW_BACKUP_BUCKET=
GMKRAW_BACKUP_PREFIX=backups
GMKRAW_BACKUP_PASSPHRASE=
